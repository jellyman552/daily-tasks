# Copy this file to .env and fill it in.

# The web address you'll open on your iPhone (no https://). Must point at this server.
DOMAIN=tasks.example.com

# The password you'll type once on your phone to sign in. Make it long.
APP_PASSWORD=change-me-to-something-long

# Your email, sent to Apple's push service as the contact for this app.
VAPID_SUBJECT=mailto:you@example.com

# Your timezone, so 7:00 means 7:00 where you live. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# Reminder tuning (minutes)
NUDGE_GRACE_MIN=10   # how long past the estimate before "did you finish?"
NUDGE_REPEAT_MIN=30  # how often to re-ask while it's still not done
NUDGE_MAX=3          # most "did you finish?" reminders per task per day
